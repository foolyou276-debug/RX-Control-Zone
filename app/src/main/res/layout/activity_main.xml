<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0A0F"
    android:padding="0dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#12121A"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="R4X POCKET VPS"
            android:textColor="#00E5FF"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/connText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏳ Connecting..."
            android:textColor="#888888"
            android:textSize="12sp"
            android:layout_marginTop="2dp"/>

    </LinearLayout>

    <!-- Status bar -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔗 Telegram se connect ho raha hun..."
        android:textColor="#00E5FF"
        android:textSize="13sp"
        android:padding="12dp"
        android:background="#0D1117"/>

    <!-- Loader -->
    <ProgressBar
        android:id="@+id/loader"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:indeterminate="true"
        android:indeterminateTint="#00E5FF"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:visibility="visible"/>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1E1E2E"/>

    <!-- Device header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#0D1117">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CONNECTED DEVICES"
            android:textColor="#555577"
            android:textSize="11sp"
            android:letterSpacing="0.1"/>

        <Button
            android:id="@+id/btnRefresh"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="↻ Refresh"
            android:textColor="#00E5FF"
            android:textSize="11sp"
            android:background="#1A1A2E"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"/>

    </LinearLayout>

    <!-- Device List -->
    <ListView
        android:id="@+id/deviceList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#1E1E2E"
        android:dividerHeight="1dp"
        android:background="#0A0A0F"/>

</LinearLayout>
